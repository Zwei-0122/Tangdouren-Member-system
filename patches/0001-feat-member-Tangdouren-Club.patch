+                  {showAllHistory ? c.collapse : c.viewAll}
+                </button>
+              )}
+            </div>
+          </>
+        )}
+
+        {error && <p className="rounded-xl bg-red-50 px-3 py-2 text-sm text-red-600">{error}</p>}
+
+        {dashboard && (
+          <button className="btn-ghost w-full text-xs text-charcoal-light" onClick={switchAccount}>
+            {c.switchAccount}
+          </button>
+        )}
+      </div>
+    </div>
+  )
+}
