+--   ALTER TABLE timer_sessions DROP COLUMN IF EXISTS reward_eligible;
+--   ALTER TABLE timer_sessions DROP COLUMN IF EXISTS member_id;
+--   DROP TABLE IF EXISTS members;
+-- ============================================================
